# Copy to .env.local and fill in from your Supabase project settings.

# Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings -> API Keys. Server-only: never referenced from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Settings -> JWT Keys. Used to sign the impersonation token (docs/adr/0001).
# Leave blank if the project only offers asymmetric JWT signing keys.
SUPABASE_JWT_SECRET=
