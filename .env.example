# Copy to .env.local and fill in from your Supabase project settings.
# Values must be pasted raw: no angle brackets, no quotes.

# Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Settings -> API Keys -> "Legacy API Keys" tab. Both start with eyJ.
# The legacy pair is used deliberately: it shares the symmetric JWT regime that
# the impersonation token is signed under (docs/adr/0001). Mixing in the newer
# sb_publishable_ / sb_secret_ keys would cross that boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Settings -> JWT Keys -> legacy JWT secret. Signs the impersonation token.
# Leave blank only if the project offers asymmetric signing keys alone.
SUPABASE_JWT_SECRET=

# Settings -> Database -> Database password.
# Paste the password ALONE, exactly as shown, with no quotes and no URL around
# it. This is preferred over DATABASE_URL precisely because a bare password has
# no syntax to get wrong: Supabase passwords routinely contain @ # % and *, all
# of which are structural characters inside a connection URI. The host is
# derived from NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_DB_PASSWORD=

# Optional alternative if you already have a full connection string. Used only
# by scripts/migrate and scripts/seed; never by the app.
DATABASE_URL=
